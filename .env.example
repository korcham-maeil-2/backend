# 공공데이터포털(data.go.kr) 일반 인증키 — 마이페이지 > 데이터활용 > 오픈API > 개발계정 상세에서 "Decoding" 키를 복사
DATA_GO_KR_SERVICE_KEY=

# 고용24 OPEN-API — 서비스마다 인증키가 따로 발급됨 (고객센터 > OPEN-API > 신청현황)
WORK24_TRAINING_CARD_KEY=        # 국민내일배움카드 훈련과정
WORK24_TRAINING_CONSORTIUM_KEY=  # 국가인적자원개발 컨소시엄 훈련과정
WORK24_COMMON_CODE_KEY=          # 공통코드

# Anthropic(Claude) API 키 — 공고 정리(normalize)에 사용. 사용 한도가 있으니 개발 중 테스트에는 쓰지 않음
ANTHROPIC_API_KEY=
# 공고 정리 방법: 비우거나 claude면 실제 Claude, fixture면 시연 공고용 미리 써 둔 응답 (비용 0원, 화면 개발용). 그 밖의 값은 서버가 켜지지 않음
NORMALIZE_MODE=
# 이미지 읽기(Claude 이미지 인식) 하루 상한, 장 수 (기본 300 ≈ $7.5). 넘으면 503. claude 모드에서만 쓴다
VISION_DAILY_PAGE_LIMIT=

# LangGraph 체크포인트 SQLite 파일 경로 (기본 var/checkpoints.sqlite)
CHECKPOINT_DB_PATH=
# 허용할 프론트 주소, 쉼표로 구분 (기본 http://localhost:3000)
CORS_ORIGINS=
